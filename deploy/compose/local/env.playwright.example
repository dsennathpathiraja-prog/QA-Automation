# Copy next to your shell env or into a `.env` beside docker-compose.local.yml
# (Compose loads `.env` from the compose file directory automatically).

# IP Docker injects for sdk.paynsure.internal inside playwright-mcp (mapping value).
# host-gateway = the machine running Docker (shop published on host / host network).
# Use a LAN IP when the shop is another machine on the VPN (find with: getent hosts sdk.paynsure.internal).
PLAYWRIGHT_MCP_SHOP_IP=host-gateway

# To add another private host, edit docker-compose.local.yml extra_hosts as a mapping, e.g.:
#   api.paynsure.internal: host-gateway
# Do not use a YAML list of "host:ip" strings — Compose on Windows requires a mapping.
