# Copy next to your shell env or into a `.env` beside docker-compose.local.yml
# (Compose loads `.env` from the compose file directory automatically).

# Required when using docker-compose.playwright-shop.yml (PayNSure / private shop DNS).
# Must be the real LAN / VPN IP that answers for Host: sdk.paynsure.internal — NOT host-gateway
# unless the shop VirtualHost truly listens on the Docker host.
#
# Linux/macOS:
#   export PLAYWRIGHT_MCP_SHOP_IP=$(getent hosts sdk.paynsure.internal | awk '{print $1; exit}')
#
# Windows PowerShell:
#   $env:PLAYWRIGHT_MCP_SHOP_IP = (Resolve-DnsName sdk.paynsure.internal -Type A |
#     Where-Object { $_.IPAddress } | Select-Object -First 1).IPAddress
#
PLAYWRIGHT_MCP_SHOP_IP=203.0.113.10

# Apply shop DNS overlay (do not rely on the base compose file for sdk.paynsure.internal):
#   docker compose -f deploy/compose/local/docker-compose.local.yml `
#     -f deploy/compose/local/docker-compose.playwright-shop.yml `
#     --profile browser up -d --force-recreate playwright-mcp
#
# Then: bash deploy/compose/scripts/verify-playwright-shop-dns.sh  (expect HTTP 2xx)

# To add another private host, edit docker-compose.playwright-shop.yml extra_hosts as a mapping, e.g.:
#   api.paynsure.internal: ${PLAYWRIGHT_MCP_SHOP_IP}
# Do not use a YAML list of "host:ip" strings — Compose on Windows requires a mapping.
